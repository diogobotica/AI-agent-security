{
  "_comment": "Base guard policy of the flow plugin. Each project adds or overrides keys in its .workflow/policy.json; the merged result is written to .workflow/kit/guard-policy.json at every session start. Role 'work' = the stories/ folder.",
  "protected_paths": [
    ".env",
    ".env.*",
    "*/.env",
    "*/.env.*",
    "secrets/*",
    "*/secrets/*",
    "*.pem",
    "*.pfx",
    ".claude/*",
    ".github/workflows/*",
    "context/docs/*",
    "stories/board.json",
    "stories/BOARD.md",
    ".githooks/*",
    ".workflow/*",
    "*appsettings.*.local.json",
    "suite-packages/*",
    "client-data/*"
  ],
  "protected_reason": {
    ".claude/*": "Agents do not edit their own guardrails.",
    ".github/workflows/*": "CI is the last safety net; change it by hand.",
    "context/docs/*": "Planning documents; the founder replaces them himself.",
    "stories/board.json": "Change story status only with .workflow/kit/scripts/board.py.",
    "stories/BOARD.md": "Generated by .workflow/kit/scripts/board.py.",
    ".githooks/*": "Git hooks that block secrets; the founder changes them by hand.",
    ".workflow/*": "The project's workflow settings and the plugin's synced files; the founder changes .workflow/policy.json (or /flow:init does, after his approval).",
    "suite-packages/*": "Founder-authored attack content (US-909). Agents never write or edit it.",
    "client-data/*": "Real client data; agents never read or write it."
  },
  "test_paths": [
    "api/tests/*",
    "*.Tests/*",
    "*Tests/*.cs",
    "worker/tests/*",
    "*/test_*.py",
    "*/*_test.py",
    "frontend/*.test.ts",
    "frontend/*.test.tsx",
    "frontend/*__tests__/*",
    "mock-agent/tests/*"
  ],
  "e2e_paths": [
    "e2e/*"
  ],
  "work_dir": "stories/*",
  "roles": {
    "planner": {
      "write": [
        "work"
      ]
    },
    "test-writer": {
      "write": [
        "tests",
        "work"
      ]
    },
    "implementer": {
      "write": [
        "anything_except_tests"
      ]
    },
    "code-reviewer": {
      "write": [
        "work"
      ]
    },
    "security-reviewer": {
      "write": [
        "work"
      ]
    },
    "e2e-tester": {
      "write": [
        "e2e",
        "work"
      ]
    },
    "guardian": {
      "write": [
        "work"
      ]
    },
    "git-ops": {
      "write": [
        "work",
        "repo_config"
      ]
    },
    "reporter": {
      "write": [
        "work"
      ]
    },
    "lead": {
      "write": [
        "work"
      ]
    },
    "unknown": {
      "write": []
    }
  },
  "dependencies": {
    "min_age_days": 14,
    "require_latest_stable": true,
    "allow_older_versions": {},
    "npm_min_weekly_downloads": 5000,
    "typosquat_watchlist": [
      "react",
      "react-dom",
      "next",
      "vite",
      "typescript",
      "tailwindcss",
      "zod",
      "axios",
      "lodash",
      "eslint",
      "prettier",
      "vitest",
      "jest",
      "playwright",
      "@playwright/test",
      "requests",
      "httpx",
      "pydantic",
      "fastapi",
      "pytest",
      "numpy",
      "pandas",
      "openai",
      "anthropic",
      "ruff",
      "mypy",
      "sqlalchemy",
      "cryptography",
      "Newtonsoft.Json",
      "Serilog",
      "xunit",
      "FluentAssertions",
      "garak",
      "pyrit",
      "promptfoo",
      "Microsoft.EntityFrameworkCore",
      "Npgsql.EntityFrameworkCore.PostgreSQL",
      "Azure.Identity",
      "Azure.Security.KeyVault.Secrets",
      "Azure.Storage.Blobs",
      "Azure.Messaging.ServiceBus"
    ],
    "allowed_licenses": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "MPL-2.0",
      "PostgreSQL",
      "Python-2.0",
      "0BSD",
      "Unlicense"
    ]
  },
  "code_rules": [
    {
      "id": "no-plan-literal",
      "pattern": "plan\\s*==\\s*[\"']",
      "message": "Business rules are data: use the entitlement service, not plan name comparisons."
    },
    {
      "id": "no-ignore-query-filters",
      "pattern": "IgnoreQueryFilters\\(",
      "allow_in": [
        "*/Admin/*",
        "*/Erasure/*"
      ],
      "message": "IgnoreQueryFilters only in admin or erasure code."
    },
    {
      "id": "no-secure-word-ui",
      "pattern": "[\"'>][^\"'<]*\\bsecure\\b",
      "only_in": [
        "frontend/*"
      ],
      "message": "Never call an agent 'secure' in the UI."
    },
    {
      "id": "no-model-names",
      "pattern": "(gpt-[0-9]|claude-[a-z]+-[0-9]|mistral-large|llama-?3)",
      "allow_in": [
        "*/ModelGateway/*",
        "*/model_gateway/*",
        "*config*"
      ],
      "message": "Model names only in the model gateway configuration."
    }
  ],
  "review_loop_max_rounds": 3,
  "repo_config_paths": [
    ".gitignore",
    ".gitattributes"
  ],
  "context": {
    "handoff_at_tokens": 110000,
    "_comment": "The lead hands off to a fresh session above this context size. Lower it if quality drops late in long sessions; raise it if handoffs feel too frequent."
  },
  "usage": {
    "stop_at_weekly_percent": 90
  }
}
