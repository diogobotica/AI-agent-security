{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.readiness": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Blob": {
      "Container": "evidence",
      "ConnectionStringSecret": "blob"
    },
    "ServiceBus": {
      "ConnectionStringSecret": "bus"
    }
  },
  "Dependencies": {
    "ProbeTimeout": "00:00:02",
    "Postgres": {
      "Host": "postgres",
      "Port": 5432
    },
    "Blob": {
      "Endpoint": "http://azurite:10000/"
    },
    "ServiceBus": {
      "Endpoint": "http://servicebus:5300/health"
    },
    "Ollama": {
      "Endpoint": "http://ollama:11434/api/tags"
    }
  }
}
