# Local development settings for the Docker Compose stack (US-102). No real secrets here.
# python scripts/local_stack.py up copies this file to .env (git-ignored) on first use and
# fills every empty PASSWORD / SECRET / *KEY value with a fresh random one.
OLLAMA_MODEL=qwen2.5:0.5b
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
PLATFORM_APP_PASSWORD=
MSSQL_SA_PASSWORD=
AZURITE_ACCOUNT_NAME=platformlocal
AZURITE_ACCOUNT_KEY=

# US-103: connection strings the API reads through its local secret store (SECRETS__<name> in docker-compose.yml).
# Built by Compose from the values above, so they never hold a literal key. The Service Bus emulator only accepts its
# documented placeholder key, SAS_KEY_VALUE, which is not a secret.
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=${AZURITE_ACCOUNT_NAME};AccountKey=${AZURITE_ACCOUNT_KEY};BlobEndpoint=http://azurite:10000/${AZURITE_ACCOUNT_NAME};
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
